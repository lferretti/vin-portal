NODE_ENV=development
PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vin_portal
DATABASE_USER=vin_portal
DATABASE_PASSWORD=localdev

# JWT — PRODUCTION: inject via AWS Secrets Manager / Parameter Store
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ADMIN_SECRET=CHANGE_ME_IN_PRODUCTION_ADMIN
JWT_TTL_SECONDS=900
JWT_ISSUER=vin-portal

# Hash salts — PRODUCTION: inject via AWS Secrets Manager / Parameter Store
# Generate with: openssl rand -base64 32
OTP_HASH_SALT=CHANGE_ME_IN_PRODUCTION
CONTRACT_HASH_SALT=CHANGE_ME_IN_PRODUCTION

# OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Rate limiting
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=20
CONTRACT_RATE_LIMIT_TTL_SECONDS=600
CONTRACT_RATE_LIMIT_MAX=5

# Worker
WORKER_ENABLED=true
WORKER_INTERVAL_MS=30000
WORKER_MAX_RETRIES=5

# CORS — PRODUCTION: set to comma-separated allowed origins
# Example: CORS_ALLOWED_ORIGINS=https://portal.example.com,https://www.portal.example.com
CORS_ALLOWED_ORIGINS=

# Email (AWS SES)
EMAIL_FROM_ADDRESS=noreply@portal.example.com
EMAIL_REPLY_TO=support@portal.example.com
AWS_SES_REGION=us-east-1

# Logging
LOG_LEVEL=warn
